---
import { href } from '../lib/i18n';
const to = href('hy');
---
<!doctype html>
<html lang="hy">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>EURO.G Systems</title>
    <script is:inline define:vars={{ to, base: to.replace(/hy\/$/, '') }}>
      var l = (navigator.language || 'hy').slice(0, 2);
      location.replace(base + (l === 'ru' ? 'ru/' : l === 'en' ? 'en/' : 'hy/'));
    </script>
  </head>
  <body><a href={to}>EURO.G Systems</a></body>
</html>
